{
  "type": "json_schema",
  "json_schema": {
    "name": "airgrip_offline_response",
    "strict": false,
    "schema": {
      "type": "object",
      "properties": {
        "intent": { "type": "string", "enum": ["system", "chat", "error"] },
        "response": { "type": "string" },
        "operations": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "open_app",
                  "close_app",
                  "create_file",
                  "create_folder",
                  "delete_file",
                  "delete_folder",
                  "rename_file",
                  "rename_folder",
                  "move_file",
                  "move_folder",
                  "copy_file",
                  "copy_folder",
                  "open_file",
                  "open_folder",
                  "open_app_in_folder",
                  "write_file",
                  "browser_search",
                  "browser_open_first_result",
                  "contextual_search",
                  "vision_query",
                  "volume_up",
                  "volume_down",
                  "mute",
                  "lock_screen",
                  "sleep",
                  "shutdown",
                  "restart",
                  "screenshot",
                  "copy",
                  "paste",
                  "undo",
                  "redo",
                  "select_all",
                  "save",
                  "media_play_pause",
                  "media_next",
                  "media_prev",
                  "scroll_up",
                  "scroll_down",
                  "switch_tab",
                  "new_tab",
                  "close_tab",
                  "new_window",
                  "go_back",
                  "go_forward",
                  "type_text"
                ]
              },
              "name": { "type": "string" },
              "location": { "type": "string" },
              "extension": { "type": "string" },
              "new_name": { "type": "string" },
              "source": { "type": "string" },
              "destination": { "type": "string" },
              "text": { "type": "string" }
            },
            "required": ["action"]
          }
        }
      },
      "required": ["intent", "response", "operations"]
    }
  }
}
